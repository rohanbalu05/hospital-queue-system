# HQMS configuration. Copy to .env (git-ignored). Every key has a working local default using FAKE adapters:
# no API keys or cloud accounts are needed to build, test or demo. Never commit real secrets.

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hqms
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hqms_test
DB_POOL_MAX=10

# --- API (apps/api) ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# DEV-ONLY placeholder. Replace with a long random value (e.g. `openssl rand -hex 32`) in any shared environment.
SESSION_SECRET=dev-only-not-a-secret-change-me
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS (hosted reference deployment).
COOKIE_SECURE=false
# Comma-separated origins allowed by CORS (the web app normally uses the same-origin /api proxy, D-013).
CORS_ORIGINS=http://localhost:5173

# Honour X-Forwarded-For (set true only behind the nginx container or another trusted proxy).
TRUST_PROXY=false
# Demo conveniences, off by default. The compose demo sets all three; never set them for real data.
RUN_MIGRATIONS_ON_START=false
SEED_ON_START=false
# The seed refuses NODE_ENV=production unless this is true (D-022).
ALLOW_DEMO_SEED=false

# --- Web (apps/web) ---
WEB_PORT=5173
# Where the Vite dev server / nginx proxies /api/* (prefix stripped).
API_PROXY_TARGET=http://localhost:3000

# --- Worker (apps/worker) ---
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4
WORKER_LEASE_SEC=30
WORKER_BACKOFF_CAP_SEC=300
WORKER_HANDLER_TIMEOUT_SEC=120
# Empty = serve every job type. The compose demo splits roles: `worker` serves call_timeout,reservation_release,deliver_notification and the
# outbox; `worker-documents` serves ocr_document,reconcile_uploads with WORKER_DISPATCH_OUTBOX=false.
WORKER_JOB_TYPES=
WORKER_DISPATCH_OUTBOX=true
WORKER_ID=
# Heartbeat every N seconds (worker_heartbeats); the API reports /health `degraded` when none is newer than WORKER_STALE_SEC.
WORKER_HEARTBEAT_SEC=10
WORKER_STALE_SEC=60

# --- Hospital ---
HOSPITAL_TZ=Asia/Kolkata

# --- Provider adapters (fake/local are the defaults) ---
# local | identity-platform
IDENTITY_PROVIDER=local
# local-disk | gcs
OBJECT_STORAGE=local-disk
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10
# fake | google-vision
OCR_PROVIDER=fake
# fake | gemini
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.5-flash-lite

# --- Only read when the matching non-fake adapter is selected (leave empty for the demo) ---
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
IDENTITY_PLATFORM_API_KEY=

# --- Seed / demo ---
SEED_PASSWORD=demo1234

# --- Compose demo host ports (docker-compose.yml) ---
HQMS_WEB_PORT=5173
HQMS_API_PORT=3000
HQMS_PG_PORT=5432

# --- Smoke script (pnpm smoke) ---
API_URL=http://localhost:3000

# Added W3 (worker/providers)
OCR_TIMEOUT_SEC=90
WORKER_RECONCILE_SEED_SEC=600
# Real providers only (leave empty for the fake adapters; never commit values)

# Abuse limits (W2–W3 review fix pass, D-028). Behind nginx set TRUST_PROXY=true so limits apply per client IP.
ASSISTANT_TIMEOUT_MS=15000
ASSISTANT_MAX_CONCURRENCY=4
ASSISTANT_RATE_LIMIT_MAX=10
ASSISTANT_RATE_LIMIT_WINDOW_SEC=600
ASSISTANT_MAX_OPEN_ESCALATIONS=3
SSE_MAX_AUTHENTICATED=1000
SSE_MAX_DISPLAY=50
SSE_MAX_PER_IP=20
SSE_MAX_LIFETIME_SEC=1800
SSE_MAX_BUFFERED_BYTES=65536
UPLOAD_MAX_CONCURRENT=4
UPLOAD_MAX_DOCUMENTS_PER_PATIENT=50
UPLOAD_MAX_BYTES_PER_PATIENT=209715200
DISPLAY_RATE_LIMIT_PER_MIN=120
DISPLAY_CACHE_MS=1000

# Notifications (D-034). fake = nothing is sent, deliveries are logged (Admin > Notifications sent). real = SMS/email
# provider stubs that need SMS_API_KEY / EMAIL_API_KEY; NOT implemented yet.
NOTIFICATION_PROVIDER=fake
# Give up on one SMS/email provider call after this many seconds (the job is retried with backoff).
NOTIFICATION_TIMEOUT_SEC=30
# A booking never gets a slot whose late-grace window would leave the patient less than this many minutes to arrive (D-035).
MIN_ARRIVAL_WINDOW_MIN=10
# Per-user limits on patient-reachable reads (D-039): alternatives, today's visits, read-all; and the bell's unread count.
READS_RATE_LIMIT_PER_MIN=30
UNREAD_COUNT_RATE_LIMIT_PER_MIN=60

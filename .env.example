# HQMS configuration. Copy to .env (git-ignored). Every key has a working local default using FAKE adapters:
# no API keys or cloud accounts are needed to build, test or demo. Never commit real secrets.

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hqms
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hqms_test
DB_POOL_MAX=10

# --- API (apps/api) ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# DEV-ONLY placeholder. Replace with a long random value (e.g. `openssl rand -hex 32`) in any shared environment.
SESSION_SECRET=dev-only-not-a-secret-change-me
SESSION_TTL_HOURS=12
# Set to true when served over HTTPS (hosted reference deployment).
COOKIE_SECURE=false
# Comma-separated origins allowed by CORS (the web app normally uses the same-origin /api proxy, D-013).
CORS_ORIGINS=http://localhost:5173

# Honour X-Forwarded-For (set true only behind the nginx container or another trusted proxy).
TRUST_PROXY=false
# Demo conveniences, off by default. The compose demo sets all three; never set them for real data.
RUN_MIGRATIONS_ON_START=false
SEED_ON_START=false
# The seed refuses NODE_ENV=production unless this is true (D-022).
ALLOW_DEMO_SEED=false

# --- Web (apps/web) ---
WEB_PORT=5173
# Where the Vite dev server / nginx proxies /api/* (prefix stripped).
API_PROXY_TARGET=http://localhost:3000

# --- Worker (apps/worker) ---
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4
WORKER_LEASE_SEC=30
WORKER_BACKOFF_CAP_SEC=300
WORKER_HANDLER_TIMEOUT_SEC=120
# Empty = serve every job type. The compose demo splits roles: `worker` serves call_timeout,reservation_release and the
# outbox; `worker-documents` serves ocr_document,reconcile_uploads with WORKER_DISPATCH_OUTBOX=false.
WORKER_JOB_TYPES=
WORKER_DISPATCH_OUTBOX=true
WORKER_ID=

# --- Hospital ---
HOSPITAL_TZ=Asia/Kolkata

# --- Provider adapters (fake/local are the defaults) ---
# local | identity-platform
IDENTITY_PROVIDER=local
# local-disk | gcs
OBJECT_STORAGE=local-disk
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10
# fake | google-vision
OCR_PROVIDER=fake
# fake | gemini
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.5-flash-lite

# --- Only read when the matching non-fake adapter is selected (leave empty for the demo) ---
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
IDENTITY_PLATFORM_API_KEY=

# --- Seed / demo ---
SEED_PASSWORD=demo1234

# --- Compose demo host ports (docker-compose.yml) ---
HQMS_WEB_PORT=5173
HQMS_API_PORT=3000
HQMS_PG_PORT=5432

# --- Smoke script (pnpm smoke) ---
API_URL=http://localhost:3000

# Added W3 (worker/providers)
OCR_TIMEOUT_SEC=90
WORKER_RECONCILE_SEED_SEC=600
# Real providers only (leave empty for the fake adapters; never commit values)

{
  "name": "@hqms/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p simulation/tsconfig.json --noEmit",
    "test": "vitest run --dir integration --passWithNoTests && vitest run --config simulation/vitest.config.ts",
    "test:simulation": "vitest run --config simulation/vitest.config.ts",
    "simulate": "tsx simulation/run.ts",
    "test:concurrency": "vitest run --dir concurrency --passWithNoTests",
    "e2e": "playwright test --trace off"
  },
  "devDependencies": {
    "@hqms/domain": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
